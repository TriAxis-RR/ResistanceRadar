#!/bin/bash
#BSUB -J "GENOMAD_SELECTED8[1-8]%2"
#BSUB -q single_chassis
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=64GB]"
#BSUB -W 72:00
#BSUB -o rr-analysis/hendriksen_sensitivity/stage3_5_mobility/logs/GENOMAD_SELECTED8_%I_%J.out
#BSUB -e rr-analysis/hendriksen_sensitivity/stage3_5_mobility/logs/GENOMAD_SELECTED8_%I_%J.err

set -euo pipefail

REPO="/rsstu/users/s/sleblan/MismatchRepair/Project/pipeline/rr-pipeline"
SAMPLESHEET="${REPO}/rr-analysis/hendriksen_sensitivity/metadata/hendriksen_selected8_stage3_5_genomad_samples.tsv"
GENOMAD="/rsstu/users/s/sleblan/MismatchRepair/Project/envs/rr_mobility/bin/genomad"
export PATH="/rsstu/users/s/sleblan/MismatchRepair/Project/envs/rr_mobility/bin:${PATH}"
GENOMAD_DB="/rsstu/users/s/sleblan/MismatchRepair/Project/references/genomad_db/genomad_db"
OUTROOT="${REPO}/rr-analysis/hendriksen_sensitivity/stage3_5_mobility/genomad_selected8"

cd "${REPO}"

mkdir -p "${OUTROOT}"
mkdir -p "${REPO}/rr-analysis/hendriksen_sensitivity/stage3_5_mobility/logs"

LINE=$(awk -v n="${LSB_JOBINDEX}" 'NR==n+1 {print}' "${SAMPLESHEET}")

if [[ -z "${LINE}" ]]; then
  echo "ERROR: No sample line found for LSB_JOBINDEX=${LSB_JOBINDEX}"
  exit 1
fi

SAMPLE_ID=$(echo "${LINE}" | awk '{print $1}')
CONTIGS=$(echo "${LINE}" | awk '{print $2}')

echo "========================================"
echo "Stage 3.5 geNomad mobility/viral/plasmid annotation - selected8"
echo "Sample: ${SAMPLE_ID}"
echo "Contigs: ${CONTIGS}"
echo "Output root: ${OUTROOT}"
echo "Database: ${GENOMAD_DB}"
echo "Job index: ${LSB_JOBINDEX}"
echo "========================================"

if [[ ! -s "${CONTIGS}" ]]; then
  echo "ERROR: Missing or empty contigs file: ${CONTIGS}"
  exit 1
fi

if [[ ! -d "${GENOMAD_DB}" ]]; then
  echo "ERROR: Missing geNomad database directory: ${GENOMAD_DB}"
  exit 1
fi

OUTDIR="${OUTROOT}/${SAMPLE_ID}"

if [[ -d "${OUTDIR}" ]]; then
  echo "Existing geNomad output directory found: ${OUTDIR}"
  echo "Removing incomplete/old geNomad output before rerun."
  rm -rf "${OUTDIR}"
fi

"${GENOMAD}" end-to-end \
  "${CONTIGS}" \
  "${OUTDIR}" \
  "${GENOMAD_DB}" \
  --threads 8 \
  --cleanup

echo "geNomad finished for ${SAMPLE_ID}"
find "${OUTDIR}" -maxdepth 3 -type f | sort | head -50
