#!/bin/bash
#BSUB -J "KATH_BT2_B02R15[1-15]%4"
#BSUB -q single_chassis
#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -W 24:00
#BSUB -o rr-analysis/kathmandu_kbase/logs/KATH_BT2_B02R15_%I_%J.out
#BSUB -e rr-analysis/kathmandu_kbase/logs/KATH_BT2_B02R15_%I_%J.err

set -euo pipefail

REPO="/rsstu/users/s/sleblan/MismatchRepair/Project/pipeline/rr-pipeline"
SHEET="${REPO}/rr-analysis/kathmandu_kbase/metadata/kathmandu_batch02_ready15_bowtie2_samples.tsv"
INDEX="/rsstu/users/s/sleblan/MismatchRepair/Project/references/decontamination/v1.0/decontamination_v1.0"

cd "${REPO}"

source /usr/local/apps/miniconda20240526/etc/profile.d/conda.sh
conda activate /rsstu/users/s/sleblan/MismatchRepair/Project/envs/rr_meta

mkdir -p "${REPO}/rr-analysis/kathmandu_kbase/logs"
mkdir -p "${REPO}/rr-analysis/kathmandu_kbase/checkpoints"

sample_id=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $1}' "${SHEET}")
matrix=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $2}' "${SHEET}")
source_group=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $3}' "${SHEET}")
r1=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $4}' "${SHEET}")
r2=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $5}' "${SHEET}")
out_dir=$(awk -v i="${LSB_JOBINDEX}" 'NR==i+1 {print $6}' "${SHEET}")

echo "========================================"
echo "Kathmandu Bowtie2/decontamination batch02 ready15"
echo "Task index: ${LSB_JOBINDEX}"
echo "Sample: ${sample_id}"
echo "Matrix: ${matrix}"
echo "Source group: ${source_group}"
echo "R1: ${r1}"
echo "R2: ${r2}"
echo "Index: ${INDEX}"
echo "Output: ${out_dir}"
echo "========================================"

if [[ -z "${sample_id}" ]]; then
  echo "ERROR: No sample found for LSB_JOBINDEX=${LSB_JOBINDEX}"
  exit 1
fi

if [[ ! -s "${r1}" ]]; then
  echo "ERROR: Missing R1: ${r1}"
  exit 1
fi

if [[ ! -s "${r2}" ]]; then
  echo "ERROR: Missing R2: ${r2}"
  exit 1
fi

mkdir -p "${out_dir}"

bowtie2 \
  --very-sensitive \
  -x "${INDEX}" \
  -1 "${r1}" \
  -2 "${r2}" \
  --threads 2 \
  --un-conc-gz "${out_dir}/${sample_id}_decontam_R%.fastq.gz" \
  -S /dev/null \
  2> "${out_dir}/${sample_id}.bowtie2.summary.txt"

touch "${REPO}/rr-analysis/kathmandu_kbase/checkpoints/${sample_id}_BATCH02_READY15_BOWTIE2_COMPLETE.txt"

echo "DONE: ${sample_id}"
ls -lh "${out_dir}"
