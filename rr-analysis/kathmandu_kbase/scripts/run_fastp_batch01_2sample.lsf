#!/bin/bash
#BSUB -J "KATH_FASTP_B01[1-2]%2"
#BSUB -q single_chassis
#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -W 24:00
#BSUB -o rr-analysis/kathmandu_kbase/logs/KATH_FASTP_B01_%I_%J.out
#BSUB -e rr-analysis/kathmandu_kbase/logs/KATH_FASTP_B01_%I_%J.err

set -euo pipefail

REPO="/rsstu/users/s/sleblan/MismatchRepair/Project/pipeline/rr-pipeline"
SAMPLESHEET="${REPO}/rr-analysis/kathmandu_kbase/metadata/kathmandu_batch01_2sample_fastp_samples.tsv"
FASTP="/rsstu/users/s/sleblan/MismatchRepair/Project/envs/rr_meta/bin/fastp"
OUTROOT="${REPO}/rr-analysis/kathmandu_kbase/results/fastp_batch01_2sample"

cd "${REPO}"

mkdir -p "${OUTROOT}"
mkdir -p "${REPO}/rr-analysis/kathmandu_kbase/logs"

LINE=$(awk -v n="${LSB_JOBINDEX}" 'NR==n+1 {print}' "${SAMPLESHEET}")

if [[ -z "${LINE}" ]]; then
  echo "ERROR: No sample line found for LSB_JOBINDEX=${LSB_JOBINDEX}"
  exit 1
fi

SAMPLE_ID=$(echo "${LINE}" | awk '{print $1}')
READ1=$(echo "${LINE}" | awk '{print $2}')
READ2=$(echo "${LINE}" | awk '{print $3}')
GROUP=$(echo "${LINE}" | awk '{print $4}')

OUTDIR="${OUTROOT}/${SAMPLE_ID}"
mkdir -p "${OUTDIR}"

echo "========================================"
echo "Kathmandu FASTP batch01 2-sample test"
echo "Sample: ${SAMPLE_ID}"
echo "Group: ${GROUP}"
echo "Read1: ${READ1}"
echo "Read2: ${READ2}"
echo "Output: ${OUTDIR}"
echo "Job index: ${LSB_JOBINDEX}"
echo "========================================"

if [[ ! -s "${READ1}" ]]; then
  echo "ERROR: Missing READ1: ${READ1}"
  exit 1
fi

if [[ ! -s "${READ2}" ]]; then
  echo "ERROR: Missing READ2: ${READ2}"
  exit 1
fi

if [[ ! -x "${FASTP}" ]]; then
  echo "ERROR: fastp not executable: ${FASTP}"
  exit 1
fi

"${FASTP}" \
  -i "${READ1}" \
  -I "${READ2}" \
  -o "${OUTDIR}/${SAMPLE_ID}_fastp_R1.fastq.gz" \
  -O "${OUTDIR}/${SAMPLE_ID}_fastp_R2.fastq.gz" \
  --detect_adapter_for_pe \
  --thread 2 \
  --html "${OUTDIR}/${SAMPLE_ID}_fastp.html" \
  --json "${OUTDIR}/${SAMPLE_ID}_fastp.json" \
  --report_title "${SAMPLE_ID}_Kathmandu_FASTP"

echo "FASTP finished for ${SAMPLE_ID}"
ls -lh "${OUTDIR}"
