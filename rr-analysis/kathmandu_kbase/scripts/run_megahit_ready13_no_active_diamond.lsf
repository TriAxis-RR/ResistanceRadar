#!/bin/bash
#BSUB -J "KATH_MEGAHIT_R13[1-13]%1"
#BSUB -q single_chassis
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=96GB]"
#BSUB -W 72:00
#BSUB -o rr-analysis/kathmandu_kbase/logs/KATH_MEGAHIT_R13_%I_%J.out
#BSUB -e rr-analysis/kathmandu_kbase/logs/KATH_MEGAHIT_R13_%I_%J.err

set -euo pipefail

REPO="/rsstu/users/s/sleblan/MismatchRepair/Project/pipeline/rr-pipeline"
SAMPLESHEET="${REPO}/rr-analysis/kathmandu_kbase/metadata/kathmandu_megahit_ready13_no_active_diamond_samples.tsv"

OUTROOT="${REPO}/rr-analysis/kathmandu_kbase/results/megahit_ready13_no_active_diamond"
CHECKDIR="${REPO}/rr-analysis/kathmandu_kbase/checkpoints"

mkdir -p "${OUTROOT}" "${CHECKDIR}" "${REPO}/rr-analysis/kathmandu_kbase/logs"

source /usr/local/apps/miniconda20240526/etc/profile.d/conda.sh
conda activate /rsstu/users/s/sleblan/MismatchRepair/Project/envs/rr_meta

LINE=$(awk -F'\t' -v IDX="${LSB_JOBINDEX}" 'NR==IDX+1 {print}' "${SAMPLESHEET}")

if [[ -z "${LINE}" ]]; then
    echo "No sample found for LSB_JOBINDEX=${LSB_JOBINDEX}"
    exit 1
fi

IFS=$'\t' read -r SAMPLE_ID MATRIX SOURCE_GROUP READ1 READ2 <<< "${LINE}"

if [[ "${READ1}" != /* ]]; then
    READ1="${REPO}/${READ1}"
fi

if [[ "${READ2}" != /* ]]; then
    READ2="${REPO}/${READ2}"
fi

SAMPLE_OUT="${OUTROOT}/${SAMPLE_ID}"

echo "========================================="
echo "Kathmandu MEGAHIT ready13"
echo "Date: $(date)"
echo "Sample: ${SAMPLE_ID}"
echo "Matrix: ${MATRIX}"
echo "Source group: ${SOURCE_GROUP}"
echo "READ1: ${READ1}"
echo "READ2: ${READ2}"
echo "Output: ${SAMPLE_OUT}"
echo "========================================="

if [[ ! -s "${READ1}" ]]; then
    echo "Missing READ1: ${READ1}"
    exit 1
fi

if [[ ! -s "${READ2}" ]]; then
    echo "Missing READ2: ${READ2}"
    exit 1
fi

rm -rf "${SAMPLE_OUT}.tmp"
mkdir -p "${SAMPLE_OUT}.tmp"

megahit \
  -1 "${READ1}" \
  -2 "${READ2}" \
  -o "${SAMPLE_OUT}.tmp" \
  --out-prefix "${SAMPLE_ID}" \
  -t 8 \
  --min-contig-len 1000

mv "${SAMPLE_OUT}.tmp" "${SAMPLE_OUT}"

FINAL_CONTIGS="${SAMPLE_OUT}/${SAMPLE_ID}.contigs.fa"

if [[ ! -s "${FINAL_CONTIGS}" ]]; then
    echo "Missing final contigs: ${FINAL_CONTIGS}"
    exit 1
fi

touch "${CHECKDIR}/${SAMPLE_ID}_MEGAHIT_COMPLETE.txt"

echo "Completed MEGAHIT: ${SAMPLE_ID}"
echo "Final contigs: ${FINAL_CONTIGS}"
echo "Date: $(date)"
